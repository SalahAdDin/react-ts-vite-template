{
  "name": "react-ts-vite-template",
  "description": "Boilerplate for React/Typescript, built on top of Vite ⚡️",
  "private": true,
  "version": "1.3.1",
  "license": "MIT",
  "main": "src/main.tsx",
  "author": "Luis Alaguna <alagunasalahaddin@live.com>",
  "homepage": "https://github.com/SalahAdDin/react-ts-vite-template#readme",
  "repository": "git@github.com:SalahAdDin/react-ts-vite-template.git",
  "bugs": "https://github.com/SalahAdDin/react-ts-vite-template/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --watch --coverage",
    "test:ui": "vitest --watch --ui",
    "test:ui:coverage": "vitest --watch --ui --coverage",
    "test:preview": "vitest-preview",
    "test:e2e": "playwright test --trace on --pass-with-no-tests",
    "test:e2e:watch": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "test:e2e:help": "playwright --help",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint src",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier src --check",
    "format:fix": "pnpm prettier --write",
    "format:lint": "pnpm prettier:fix && pnpm lint:fix",
    "lint-staged": "lint-staged",
    "type-check": "tsc",
    "prepare": "husky",
    "commit": "commitlint",
    "release": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "@hookform/resolvers": "4.0.0",
    "@tanstack/react-query": "5.66.0",
    "@tanstack/react-router": "1.102.5",
    "axios": "1.7.9",
    "dotenv": "16.4.7",
    "million": "3.1.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "valibot": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@commitlint/types": "19.5.0",
    "@eslint/js": "9.20.0",
    "@faker-js/faker": "9.5.0",
    "@hookform/devtools": "4.3.3",
    "@ianvs/prettier-plugin-sort-imports": "4.4.1",
    "@playwright/test": "1.50.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@semantic-release/npm": "12.0.1",
    "@semantic-release/release-notes-generator": "14.0.3",
    "@stylistic/eslint-plugin": "3.1.0",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/eslint-plugin-query": "5.66.1",
    "@tanstack/react-query-devtools": "5.66.0",
    "@tanstack/router-devtools": "1.102.5",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.24.0",
    "@vitejs/plugin-react-swc": "3.8.0",
    "@vitest/coverage-v8": "3.0.5",
    "@vitest/eslint-plugin": "1.1.30",
    "@vitest/ui": "3.0.5",
    "eslint": "9.20.1",
    "eslint-config-prettier": "10.0.1",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-import-x": "4.6.1",
    "eslint-plugin-jest-dom": "5.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.2.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "eslint-plugin-sonarjs": "3.0.1",
    "eslint-plugin-testing-library": "7.1.1",
    "globals": "15.15.0",
    "happy-dom": "17.1.0",
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "msw": "2.7.0",
    "prettier": "3.5.0",
    "prettier-plugin-tailwindcss": "0.6.11",
    "semantic-release": "24.2.2",
    "tailwindcss": "4.0.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.1.0",
    "vitest": "3.0.5",
    "vitest-dom": "0.1.1",
    "vitest-preview": "0.0.1",
    "web-vitals": "4.2.4"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "keywords": ["react", "boilerplate", "vite", "bundle", "typescript"],
  "packageManager": "pnpm@9.6.0"
}
